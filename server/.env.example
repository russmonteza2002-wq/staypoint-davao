# Server Execution Environment
NODE_ENV=development
PORT=5000

# Database Connection (PostgreSQL or SQLite fallback for local dev)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/apartment_db?schema=public"

# Security & JWT Configuration
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# File Storage Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880 # 5MB in bytes

# CORS Configuration
CLIENT_URL=http://localhost:5173
